{
  "name": "carousel",
  "version": "0.2.0",
  "description": "Edit, layer, reorder and preview images as they will appear in an Instagram carousel post",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "local.carousel",
    "productName": "Carousel",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@fontsource/source-code-pro": "^5.3.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
